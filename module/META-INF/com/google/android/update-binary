#!/sbin/sh
umask 022
ui_print() { echo "$1"; }
require_new_magisk() {
  ui_print "************************"
  ui_print " Please install Magisk/APatch/KSU "
  ui_print "************************"
  exit 1
}
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
[ -f /data/adb/ap/util_functions.sh ] && . /data/adb/ap/util_functions.sh
[ -f /data/adb/ksu/bin/busybox ] && [ -f /data/adb/ksu/util_functions.sh ] && . /data/adb/ksu/util_functions.sh
install_module
exit 0